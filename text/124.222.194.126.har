            "text": "{\"code\":0,\"message\":\"success\",\"data\":{\"id\":\"80000000-0000-0000-0000-000000000001\",\"code\":\"feedback\",\"name\":\"访客意见反馈\",\"description\":\"意见反馈表单，由后台「表单配置」维护，前端通过表单 ID 动态渲染。\",\"schema\":\"{\\\"fields\\\": [{\\\"key\\\": \\\"name\\\", \\\"type\\\": \\\"text\\\", \\\"label\\\": \\\"您的称呼\\\", \\\"required\\\": true, \\\"placeholder\\\": \\\"请输入称呼\\\"}, {\\\"key\\\": \\\"contact\\\", \\\"type\\\": \\\"text\\\", \\\"label\\\": \\\"联系方式\\\", \\\"placeholder\\\": \\\"邮箱 / 手机号（选填）\\\"}, {\\\"key\\\": \\\"topic\\\", \\\"type\\\": \\\"select\\\", \\\"label\\\": \\\"反馈类型\\\", \\\"options\\\": [{\\\"label\\\": \\\"内容纠错\\\", \\\"value\\\": \\\"correction\\\"}, {\\\"label\\\": \\\"建议\\\", \\\"value\\\": \\\"suggestion\\\"}, {\\\"label\\\": \\\"问题反馈\\\", \\\"value\\\": \\\"bug\\\"}], \\\"required\\\": true}, {\\\"key\\\": \\\"rating\\\", \\\"type\\\": \\\"radio\\\", \\\"label\\\": \\\"满意度\\\", \\\"options\\\": [{\\\"label\\\": \\\"满意\\\", \\\"value\\\": \\\"good\\\"}, {\\\"label\\\": \\\"一般\\\", \\\"value\\\": \\\"ok\\\"}, {\\\"label\\\": \\\"不满意\\\", \\\"value\\\": \\\"bad\\\"}]}, {\\\"key\\\": \\\"content\\\", \\\"type\\\": \\\"textarea\\\", \\\"label\\\": \\\"反馈内容\\\", \\\"required\\\": true, \\\"placeholder\\\": \\\"请描述您的问题或建议\\\"}, {\\\"key\\\": \\\"visitDate\\\", \\\"type\\\": \\\"date\\\", \\\"label\\\": \\\"访问日期\\\"}]}\",\"status\":\"active\",\"createdBy\":null,\"updatedBy\":null,\"createdAt\":\"2026-08-24T15:00:43.486957\",\"updatedAt\":\"2026-08-24T15:00:43.486957\"},\"timestamp\":1789576465717}"
