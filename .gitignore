# ============================================================================
# 仓库根 .gitignore —— 走进多彩 56 个民族世界（Spring Boot + Vue3 全栈）
# 说明：
#   - 无斜杠开头的模式（如 node_modules、dist）会匹配任意层级的同名文件/目录
#   - 敏感配置只允许上传模板（application-example.yaml），真实凭据一律忽略
# ============================================================================

# ---------------------- 依赖与构建产物 ----------------------
node_modules
dist
dist-ssr
coverage
*.tsbuildinfo

# 日志
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------- 环境变量文件 ----------------------
# 保留 .env.development / .env.production（接口地址，无凭据）；
# 本地私有环境变量（可能含真实接口地址/令牌）一律忽略
.env.local
.env.*.local
.env
!.env.development
!.env.production

# ---------------------- 后端敏感配置（最重要） ----------------------
# 各环境真实配置含 数据库/Redis/邮箱/加密密钥/初始管理员 凭据，禁止上传；
# 需要新环境时复制 application-example.yaml 使用（该模板不含真实凭据）
backend/src/main/resources/application-dev.yaml
backend/src/main/resources/application-prod.yaml
backend/src/main/resources/application-local.yaml
backend/src/main/resources/application-*.yaml
backend/src/main/resources/application-*.yml
!backend/src/main/resources/application.yaml
!backend/src/main/resources/application-example.yaml
backend/src/main/resources/application.yml

# ---------------------- 编辑器 / IDE ----------------------
.vscode/*
!.vscode/extensions.json
.idea
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统
.DS_Store
Thumbs.db

# 运行时产物
backend/dist/
backend/.gradle/
backend/build/
admin/dist/
mobile/dist/
mobile/.expo/
